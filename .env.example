# ClipForge AI - Environment Configuration

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_TEMPERATURE=0.3

# Backend & Storage
PROJECT_NAME="ClipForge AI"
API_V1_STR=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./clipforge.db
MAX_UPLOAD_SIZE_MB=2048
MAX_VIDEO_DURATION_SECONDS=3600

# Video Defaults
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
DEFAULT_CLIP_COUNT=5
